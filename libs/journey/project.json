{
  "name": "journey",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/journey/src",
  "prefix": "lib",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:journey", "type:shell"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/journey/ng-package.json",
        "tsConfig": "libs/journey/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/journey/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/journey/jest.config.ts",
        "tsConfig": "libs/journey/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build-docs": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/journey",
        "command": "npx compodoc -c ../../.compodocrc.json -p tsconfig.doc.json -n journey -d ../../dist/docs/journey/$(cat package.json | jq -cr '.version')"
      }
    }
  }
}
